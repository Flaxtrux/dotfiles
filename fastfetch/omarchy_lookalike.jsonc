{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/froakie.txt",
    "padding": {
      "top": 9,
      "right": 3,
      "left": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐"
    },
    {
      "type": "user",
      "key": "󰌢 User",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 CPU",
      "showPeCoreCount": true,
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "key": "│ ├󰿵 GPU",
      "detectionMethod": "pci",
      "keyColor": "cyan"
    },
    {
      "type": "display",
      "key": "│ ├󱄄 Display",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊 Disk",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "│ ├󰍛 RAM",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡 Swap",
      "keyColor": "cyan"
    },
    {
      "type": "localip",
      "key": "└ └󰈀 IP",
      "keyColor": "cyan",
      "showIpv4": true,
      "showIpv6": false
    },

    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "│ ├ WM",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "│ ├ Shell",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│ ├ Terminal",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "└ └󰏖 Packages",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Colors────────────────────────┐"
    },
    {
      "type": "colors",
      "paddingLeft": 14,
      "symbol": "block"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
  ]
}
